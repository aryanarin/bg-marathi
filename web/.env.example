# ---------------------------------------------------------------------------
# Bhagavad Gita learning platform - environment variables
#
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is git-ignored and must NEVER be committed.
#
# Every variable is documented in docs/setup.md. Variables prefixed with
# NEXT_PUBLIC_ are embedded into the browser bundle and must only ever hold
# values that are safe to be public.
# ---------------------------------------------------------------------------

# --- Supabase: safe to expose to the browser -------------------------------

# Your Supabase project URL, e.g. https://abcdefghijklm.supabase.co
# Supabase Dashboard > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# The anon/publishable key. This key is designed to be public: it carries no
# privileges of its own and every request made with it is filtered by Row
# Level Security. Safe to ship to the browser.
# Supabase Dashboard > Project Settings > API Keys > anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# --- Supabase: SECRET, server-only -----------------------------------------

# The service-role key BYPASSES Row Level Security entirely. Treat it like a
# database root password.
#   - Never prefix it with NEXT_PUBLIC_
#   - Never import it into a Client Component
#   - It is only read by scripts/ and by src/lib/supabase/admin.ts
# Supabase Dashboard > Project Settings > API Keys > service_role
SUPABASE_SERVICE_ROLE_KEY=


# --- Application ------------------------------------------------------------

# Canonical public origin, no trailing slash. Used for auth email redirect
# links, Open Graph URLs, sitemap.xml and robots.txt.
# Local: http://localhost:3000    Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ---------------------------------------------------------------------------
# NOT stored here
# ---------------------------------------------------------------------------
# SMTP credentials for authentication emails are configured in the Supabase
# Dashboard (Project Settings > Authentication > SMTP Settings), not in this
# file. The application never sends email itself, so it never needs the SMTP
# password. See docs/email-setup.md.
# ---------------------------------------------------------------------------
